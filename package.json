{
  "name": "marking-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint firestore.rules",
    "build": "npm run check && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "firebase": "13.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.7",
    "eslint": "^10.15.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
